@model Kontakti.Models.Contact
@{
    ViewData["Title"] = "Изтриване на контакт";
}
<h2 class="mb-3">Изтриване на контакт</h2>

<p class="text-danger">Сигурни ли сте, че искате да изтриете този контакт?</p>
<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Име</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Телефон</dt>
            <dd class="col-sm-9">@Model.PhoneNumber</dd>
            <dt class="col-sm-3">Адрес 1</dt>
            <dd class="col-sm-9">@Model.AddressLine1</dd>
            <dt class="col-sm-3">Адрес 2</dt>
            <dd class="col-sm-9">@Model.AddressLine2</dd>
        </dl>
    </div>
</div>
<form asp-action="DeleteConfirmed" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Изтрий</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>